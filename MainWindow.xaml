<Window x:Class="Script.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installer Builder Configuration" Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Product Selection -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <Label Content="Select Product:" FontWeight="Bold" FontSize="14"/>
            <ComboBox x:Name="ProductComboBox" Height="30" FontSize="13" Margin="0,5,0,0">
                <ComboBoxItem Content="REA Assoc" IsSelected="True"/>
                <ComboBoxItem Content="ReCon"/>
                <ComboBoxItem Content="BigBlock"/>
                <ComboBoxItem Content="UltraBlock"/>
                <ComboBoxItem Content="Envirolok"/>
            </ComboBox>
        </StackPanel>

        <!-- Version Input -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <Label Content="Version:" FontWeight="Bold" FontSize="14"/>
            <TextBox x:Name="VersionTextBox" Height="30" FontSize="13" Margin="0,5,0,0" Text="26.1.51" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Version Date Input -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <Label Content="Version Date (yyyy-MM-dd):" FontWeight="Bold" FontSize="14"/>
            <TextBox x:Name="VersionDateTextBox" Height="30" FontSize="13" Margin="0,5,0,0" Text="2026-04-14" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- SoftworkzDNA Checkbox -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <CheckBox x:Name="SoftworkzDNACheckBox" Content="SoftworkzDNA" FontSize="14" FontWeight="Bold" IsChecked="False" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Output Log -->
        <GroupBox Grid.Row="4" Header="Build Output" Margin="0,0,0,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="OutputTextBox" 
                         IsReadOnly="True" 
                         TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto"
                         Background="#F5F5F5"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="11"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Build Button -->
        <Button Grid.Row="5" 
                x:Name="BuildButton" 
                Content="Build Installer" 
                Height="40" 
                FontSize="16" 
                FontWeight="Bold"
                Background="#007ACC"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Click="BuildButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#005A9E"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#CCCCCC"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
